{
  "name": "soundlings",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "generate:audio-map": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-audio-asset-map.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3",
    "react-dom": "19.1.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-native-worklets": "0.5.1",
    "react-dom": "19.1.0"
  }
}
