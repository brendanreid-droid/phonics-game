# Copy to .env and the app will sync. Without these the game runs entirely
# offline, which is a fully supported state, not a degraded one.

EXPO_PUBLIC_SUPABASE_URL=https://vtifvggqsnwpbemghqkk.supabase.co

# The PUBLISHABLE key. Safe in this file, safe in a public repo, and safe in a
# client bundle — it identifies the project and authorises nothing on its own.
# Row-level security is what actually protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_FXj6lN04kjqFyFLGGdtSmg_MwMmFXJR

# NEVER add a service_role or sb_secret_ key here or anywhere in this repo.
# It bypasses row-level security completely. In a public repo that is an
# immediate compromise of every family's data, and deleting the commit does not
# undo it — the key has to be rotated. scripts/check-no-secrets.sh fails the
# build if one is ever committed.
